#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
        macros {
                // Selects the Bluetooth profile given as its parameter.
                // Needed because hold-tap only forwards one parameter.
                bt_sel_macro: bt_sel_macro {
                        compatible = "zmk,behavior-macro-one-param";
                        #binding-cells = <1>;
                        bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
                };
        };

        behaviors {
                // Bluetooth keys only fire after being held for 3 seconds.
                // Releasing early (or a stray tap) does nothing.
                bt_clr_hold: bt_clr_hold {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <3000>;
                        bindings = <&bt>, <&none>;
                };
                bt_sel_hold: bt_sel_hold {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <3000>;
                        bindings = <&bt_sel_macro>, <&none>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |   TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | `/ALT |
// |ESC/CMD|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// |  SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | CTRL | LWR | SPC |   | ENT | BSPC | RSE |
                        display-name = "MacOS";
                        bindings = <
   &kp TAB       &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mt RALT GRAVE
   &mt LCMD ESC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                  &kp LCTRL &mo 2 &kp SPACE   &kp RET &kp BSPC &mo 3
                        >;
                };
                windows_layer {
// -----------------------------------------------------------------------------------------
// |   TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | `/ALT |
// |ESC/CTRL|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// |  SHFT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | GUI | LWR | SPC |   | ENT | BSPC | RSE |
                        display-name = "Windows";
                        bindings = <
   &kp TAB       &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mt RALT GRAVE
   &mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                  &kp LGUI &mo 2 &kp SPACE   &kp RET &kp BSPC &mo 3
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | ALT |
// |BTCLR*| BT1*| BT2*| BT3*| BT4*| BT5*|   | LFT | DWN |  UP | RGT |     |      |
// | SHFT | WIN | MAC |     |     |     |   |     |     |     |     |     |      |
//                    |     |     | SPC |   | ENT | BSPC |    |
// * Bluetooth keys must be held for 3 seconds
                        display-name = "Lower";
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp RALT
   &bt_clr_hold BT_CLR 0 &bt_sel_hold 0 0 &bt_sel_hold 1 0 &bt_sel_hold 2 0 &bt_sel_hold 3 0 &bt_sel_hold 4 0   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &to 1        &to 0        &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                           &trans       &trans       &kp SPACE    &kp RET        &kp BSPC &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | ALT |
// |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |     |     | SPC |   | ENT | BSPC |    |
                        display-name = "Raise";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK       &kp LPAR &kp RPAR &kp RALT
   &trans    &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                             &trans   &trans   &kp SPACE   &kp RET   &kp BSPC  &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
        combos {
            compatible = "zmk,combos";
            combo_caps {
                timeout-ms = <100>;
                key-positions = <24 35>;
                bindings = <&kp CAPS>;
            };
        };
};
