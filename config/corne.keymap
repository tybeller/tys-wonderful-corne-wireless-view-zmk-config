#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer indices
#define L_MAC   0
#define L_WIN   1
#define L_LOWER 2
#define L_RAISE 3
#define L_WIN_LOWER 4
#define L_ADJUST 5

/ {
        behaviors {
                // Hold for 3 seconds to clear the current Bluetooth profile.
                // Releasing early (or a stray tap) does nothing.
                bt_clr_hold: bt_clr_hold {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <3000>;
                        bindings = <&bt>, <&none>;
                };

                // Backspace normally, Delete (forward delete) with Shift held.
                bspc_del: bspc_del {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp BSPC>, <&kp DEL>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };
        };

        // Lower + Raise together -> Adjust.
        // Windows mode + Lower -> Windows versions of the screenshot/lock keys.
        conditional_layers {
                compatible = "zmk,conditional-layers";
                win_lower {
                        if-layers = <L_WIN L_LOWER>;
                        then-layer = <L_WIN_LOWER>;
                };
                adjust {
                        if-layers = <L_LOWER L_RAISE>;
                        then-layer = <L_ADJUST>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |   TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | `/ALT |
// |ESC/CMD|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// |  SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | CTRL | LWR | SPC |   | ENT | BSPC | RSE |
// BSPC sends Delete when Shift is held.
                        display-name = "MacOS";
                        bindings = <
   &kp TAB       &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mt RALT GRAVE
   &mt LCMD ESC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                  &kp LCTRL &mo L_LOWER &kp SPACE   &kp RET &bspc_del &mo L_RAISE
                        >;
                };

                windows_layer {
// -----------------------------------------------------------------------------------------
// |   TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | `/ALT |
// |ESC/CTRL|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// |  SHFT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | GUI | LWR | SPC |   | ENT | BSPC | RSE |
                        display-name = "Windows";
                        bindings = <
   &kp TAB       &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mt RALT GRAVE
   &mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT     &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                  &kp LGUI &mo L_LOWER &kp SPACE   &kp RET &bspc_del &mo L_RAISE
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1   |  2   |  3   |  4   |  5   |   |  6   |  7   |  8   |  9  |  0  | ALT |
// |      | PREV | PLAY | NEXT | VOL- | VOL+ |   | LFT  | DWN  |  UP  | RGT |     |     |
// | SHFT | MUTE | BRI- | BRI+ | SHOT | LOCK |   | HOME | PGDN | PGUP | END |     |     |
//                      |      |      | SPC  |   | ENT  | BSPC |      |
// SHOT = screenshot of a selection (Cmd+Shift+4 / Win+Shift+S)
// LOCK = lock screen (Ctrl+Cmd+Q / Win+L)
                        display-name = "Lower";
                        bindings = <
   &kp TAB    &kp N1     &kp N2       &kp N3       &kp N4          &kp N5            &kp N6   &kp N7    &kp N8    &kp N9    &kp N0 &kp RALT
   &trans     &kp C_PREV &kp C_PP     &kp C_NEXT   &kp C_VOL_DN    &kp C_VOL_UP      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans &trans
   &kp LSHFT  &kp C_MUTE &kp C_BRI_DN &kp C_BRI_UP &kp LG(LS(N4))  &kp LC(LG(Q))     &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans &trans
                                      &trans       &trans          &kp SPACE         &kp RET  &bspc_del &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | ALT |
// |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |     |     | SPC |   | ENT | BSPC |    |
                        display-name = "Raise";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK       &kp LPAR &kp RPAR &kp RALT
   &trans    &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                             &trans   &trans   &kp SPACE   &kp RET   &bspc_del &trans
                        >;
                };

                win_lower_layer {
// Active automatically in Windows mode while Lower is held.
// Only overrides SHOT (Win+Shift+S) and LOCK (Win+L); everything else falls through to Lower.
                        display-name = "Lower";
                        bindings = <
   &trans &trans &trans &trans &trans          &trans          &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans          &trans          &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &kp LG(LS(S))   &kp LG(L)       &trans &trans &trans &trans &trans &trans
                        &trans &trans          &trans          &trans &trans &trans
                        >;
                };

                adjust_layer {
// Hold Lower + Raise.
// -----------------------------------------------------------------------------------------
// |BTCLR*| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     | BOOT |
// | RST  |     |BTPRV|BTNXT| USB | BLE |   |     |     |     |     |     | RST  |
// | BOOT | WIN | MAC |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
// * BTCLR must be held for 3 seconds.
// BOOT/RST act on the half they are pressed on (left keys = left half, right keys = right half).
// USB/BLE choose where keystrokes go when the left half is plugged in.
                        display-name = "Adjust";
                        bindings = <
   &bt_clr_hold BT_CLR_CMD 0 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &bootloader
   &sys_reset   &none        &bt BT_PRV   &bt BT_NXT   &out OUT_USB &out OUT_BLE                &none &none &none &none &none &sys_reset
   &bootloader  &to L_WIN      &to L_MAC      &none        &none        &none                       &none &none &none &none &none &none
                                          &trans       &trans       &trans                      &trans &trans &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };

        combos {
            compatible = "zmk,combos";
            combo_caps {
                timeout-ms = <100>;
                key-positions = <24 35>;
                bindings = <&kp CAPS>;
            };
        };
};
